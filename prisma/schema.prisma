generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A seller's store. Each store is fully separate and connects its own QuickBooks company.
// status: "active" | "suspended"
model Store {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  niche                String?
  status               String    @default("active")
  // Optional public page (/join/<slug>) where new customers can ask for an account. Off by default.
  allowAccountRequests Boolean   @default(false)
  // Look and profile (set in the setup questions). look: fresh|clean|craft|classic; fulfillment: delivery|pickup|both
  look                 String    @default("fresh")
  accent               String?
  logoId               String?
  bannerId             String?
  about                String?
  fulfillment          String    @default("delivery")
  unitKinds            String?
  setupDoneAt          DateTime?
  phone                String?
  email                String?
  address              String?
  createdAt            DateTime  @default(now())

  // QuickBooks Online connection (tokens are stored encrypted)
  qboRealmId          String?
  qboCompanyName      String?
  qboAccessToken      String?
  qboRefreshToken     String?
  qboAccessExpiresAt  DateTime?
  qboRefreshExpiresAt DateTime?
  qboIncomeAccountId  String?
  qboTokenVersion     Int       @default(0)

  memberships     Membership[]
  customers       Customer[]
  products        Product[]
  orders          Order[]
  accountRequests AccountRequest[]
  categories      Category[]
  uploads         Upload[]
  importBatches   ImportBatch[]
  pastInvoices    PastInvoice[]
  changes         ChangeLog[]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean      @default(false)
  emailVerifiedAt DateTime?
  // Two-step sign-in: secret encrypted with lib/crypto.ts; recovery codes stored as SHA-256 hashes (JSON array).
  totpSecret      String?
  totpEnabledAt   DateTime?
  totpLastStep    Int?
  recoveryCodes   String?
  createdAt       DateTime     @default(now())
  sessions        Session[]
  memberships     Membership[]
}

// Which store a user can use, and how. A user can belong to several stores.
// role: "owner" | "staff" | "buyer" (buyers always have a customerId)
model Membership {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role       String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
}

// Server-side login sessions. The browser only holds a random token; we store its SHA-256 hash,
// so even a copy of this database can't be used to sign in.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// A business or person that buys from a store. Becomes a Customer in QuickBooks.
model Customer {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id])
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  qboCustomerId String?
  createdAt     DateTime        @default(now())
  memberships   Membership[]
  orders        Order[]
  prices        CustomerPrice[]
  pastInvoices  PastInvoice[]

  @@unique([storeId, qboCustomerId])
  @@index([storeId])
}

// unit: the unit it's sold by (lib/units.ts); unitKind: weight|liquid|paper|length|count|packed.
// packSize is display text generated from packCount/packAmount/packUnit (kept so old orders still read well).
model Product {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id])
  sku           String
  name          String
  category      String
  unit          String
  unitKind      String          @default("count")
  packCount     Int?
  packAmount    Float?
  packUnit      String?
  byWeight      Boolean         @default(false)
  description   String?
  imageIds      String?
  packSize      String?
  priceCents    Int
  inStock       Boolean         @default(true)
  active        Boolean         @default(true)
  qboItemId     String?
  // In QuickBooks, 1 sell unit = qboUnitFactor × qboUnitLabel (e.g. 1 case = 40 lb).
  qboUnitFactor Float           @default(1)
  qboUnitLabel  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  prices        CustomerPrice[]
  lines         OrderLine[]

  @@unique([storeId, sku])
  @@unique([storeId, qboItemId])
}

// Per-customer price that overrides the product's list price.
model CustomerPrice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCents Int

  @@unique([customerId, productId])
}

// status: "new" | "packing" | "ready" | "delivered" | "cancelled"
// qboSyncStatus: "pending" | "synced" | "failed" | "not_connected"
model Order {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  number        Int
  status        String    @default("new")
  deliveryDate  DateTime?
  notes         String?
  subtotalCents Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  qboSyncStatus String    @default("pending")
  qboInvoiceId  String?
  // The QuickBooks company (realm) the invoice was created in; invoices are only touched in that company.
  qboRealmId    String?
  qboDocNumber  String?
  qboSyncedAt   DateTime?
  qboError      String?
  // Bumped when an invoiced order is reopened, so the new invoice gets a new request id and number.
  qboAttempt    Int       @default(0)

  lines OrderLine[]

  @@unique([storeId, number])
  @@unique([storeId, qboRealmId, qboInvoiceId])
  @@index([storeId, createdAt])
}

// Name/price are copied at order time so old invoices never change.
model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  sku            String
  unit           String
  packSize       String?
  qty            Float
  unitPriceCents Int
  lineTotalCents Int
}

// Every emailed one-time link (verify email, reset password, invite) and two-step sign-in tickets.
// Only SHA-256(token) is stored; each is single-use and expires.
// purpose: "verify_email" | "reset_password" | "invite" | "two_step"
model AuthToken {
  id         String    @id
  purpose    String
  userId     String?
  email      String?
  storeId    String?
  customerId String?
  role       String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([email, purpose])
}

// Someone asking a store for a customer account. status: "pending" | "approved" | "declined"
model AccountRequest {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  businessName String
  contactName  String
  email        String
  phone        String?
  message      String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([storeId, status])
}

// A store's own product categories (any niche), with an emoji shown to customers.
model Category {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String
  emoji   String @default("📦")
  sort    Int    @default(0)

  @@unique([storeId, name])
}

// An image a seller uploaded (re-encoded to WebP on the server). kind: "logo" | "banner" | "product".
// Files live in uploads/<storeId>/<id>.webp, outside public/, and are only served to that store's members.
model Upload {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind      String
  path      String
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())

  @@index([storeId])
}

// One "Bring in from QuickBooks" run, so it can be undone. kind: "items" | "customers" | "invoices".
// created: JSON array of ids we created; updated: JSON array of { id, before } we changed.
model ImportBatch {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind      String
  created   String    @default("[]")
  updated   String    @default("[]")
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([storeId, createdAt])
}

// An invoice brought in from QuickBooks as order history (read-only; never sent back to QuickBooks).
// lines: JSON [{ name, qty, rate, amountCents, qboItemId }]
model PastInvoice {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  qboInvoiceId String
  docNumber    String?
  txnDate      DateTime
  totalCents   Int
  lines        String
  batchId      String
  createdAt    DateTime @default(now())

  @@unique([storeId, qboInvoiceId])
  @@index([customerId, txnDate])
}

// Every change sellers make to products, special prices and store settings, so it can be undone
// (and the undo undone again). before/after: JSON of the fields that changed.
// entity: "product" | "customerPrices" | "store"; action: "create" | "update" | "undo"
model ChangeLog {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  entity    String
  entityId  String
  action    String
  summary   String
  before    String
  after     String
  undoOfId  String?
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([storeId, createdAt])
}
