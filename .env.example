# Database. SQLite file for local development; use a Postgres URL in production
# (and change provider in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"
# Encrypts the stored QuickBooks tokens. 32+ random characters. Never commit or share it.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# QuickBooks Online app keys from https://developer.intuit.com (My Apps -> your app -> Keys & credentials)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# Must exactly match a Redirect URI you add in the Intuit developer portal.
QBO_REDIRECT_URI="http://localhost:3000/api/qbo/callback"
# "sandbox" while testing, "production" once Intuit approves your app.
QBO_ENV="sandbox"
# Shows one-click demo logins on the sign-in page. Turn off in production.
DEMO_MODE="true"
